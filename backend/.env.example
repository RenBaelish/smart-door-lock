DATABASE_URL=sqlite:///../facelock.db
# PostgreSQL + pgvector alternative:
# DATABASE_URL=postgresql+psycopg2://facelock:facelock@localhost:5433/facelock
MATCH_THRESHOLD=0.48
DUPLICATE_THRESHOLD=0.40
MAX_IMAGE_WIDTH=800
DETECTION_MODEL=hog
UPSAMPLE_TIMES=1
REGISTER_JITTERS=3
RECOGNIZE_JITTERS=1
CORS_ORIGINS=*
